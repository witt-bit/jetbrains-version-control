{
  "name": "jetbrains-git-control",
  "displayName": "JetBrains Git Control",
  "publisher": "witt-bit",
  "description": "Bring IntelliJ IDEA / JetBrains Git experience to VS Code & Cursor: Git graph visualization, IDEA-style commit panel with shelf/stash, branch management, cherry-pick, rebase, merge, 3-way merge editor, inline git blame annotations, and context menus. The best JetBrains Git alternative for Visual Studio Code.",
  "version": "1.1.0",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/witt-bit/jetbrains-version-control"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "l10n": "./l10n",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "intellij",
    "jetbrains",
    "idea",
    "git graph",
    "commit",
    "shelf",
    "stash",
    "branch",
    "merge",
    "cherry-pick",
    "rebase",
    "git log",
    "context menu",
    "diff",
    "3-way merge",
    "webstorm",
    "pycharm",
    "goland",
    "rider",
    "version control"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "git-brains-panel",
"title": "%contrib.app.panel%",
          "icon": "$(git-branch)"
        }
      ],
      "activitybar": [
        {
          "id": "git-brains-commit",
          "title": "%contrib.app.activity%",
          "icon": "images/commit-icon.svg"
        }
      ]
    },
    "views": {
      "git-brains-panel": [
        {
          "type": "webview",
          "id": "git-brains.gitLog",
          "name": "%contrib.view.gitLog%"
        },
        {
          "type": "webview",
          "id": "git-brains.worktrees",
          "name": "%contrib.view.worktrees%"
        }
      ],
      "git-brains-commit": [
        {
          "type": "webview",
          "id": "git-brains.commitPanel",
          "name": "%contrib.view.commitPanel%"
        }
      ]
    },
    "commands": [
      {
        "command": "git-brains.refreshLog",
        "title": "%contrib.cmd.refreshLog%",
        "icon": "$(refresh)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.openMergeEditor",
        "title": "%contrib.cmd.openMergeEditor%",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.openConflicts",
        "title": "%contrib.cmd.openConflicts%",
        "icon": "$(git-merge)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.openMergeEditorFromSCM",
        "title": "%contrib.cmd.openMergeEditorFromSCM%",
        "icon": "$(git-merge)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.showFileHistory",
        "title": "%contrib.cmd.showFileHistory%",
        "icon": "$(history)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.nextDiff",
        "title": "%contrib.cmd.nextDiff%",
        "icon": "$(arrow-down)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.prevDiff",
        "title": "%contrib.cmd.prevDiff%",
        "icon": "$(arrow-up)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.commitPanel.refresh",
        "title": "%contrib.cmd.refreshChanges%",
        "icon": "$(refresh)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.commitPanel.commit",
        "title": "%contrib.cmd.commit%",
        "icon": "$(check)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.commitPanel.commitAndPush",
        "title": "%contrib.cmd.commitAndPush%",
        "icon": "$(cloud-upload)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.commitPanel.shelve",
        "title": "%contrib.cmd.shelve%",
        "icon": "$(archive)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.commitPanel.unshelve",
        "title": "%contrib.cmd.unshelve%",
        "icon": "$(package)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.openPushPanel",
        "title": "%contrib.cmd.push%",
        "icon": "$(cloud-upload)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.editSource",
        "title": "%contrib.cmd.editSource%",
        "icon": "$(go-to-file)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.annotateWithGitBlame",
        "title": "%contrib.cmd.annotate%",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.clearGitBlameAnnotation",
        "title": "%contrib.cmd.clearAnnotation%",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.worktrees.new",
        "title": "%contrib.cmd.worktreeNew%",
        "icon": "$(add)",
        "category": "%contrib.cmd.category%"
      },
      {
        "command": "git-brains.worktrees.refresh",
        "title": "%contrib.cmd.worktreeRefresh%",
        "icon": "$(refresh)",
        "category": "%contrib.cmd.category%"
      }
    ],

    "menus": {
      "view/title": [],
      "scm/title": [
        {
          "command": "git-brains.openConflicts",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "git-brains.openMergeEditorFromSCM",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "inline@10"
        }
      ],
      "editor/context": [
        {
          "command": "git-brains.showFileHistory",
          "when": "editorTextFocus",
          "group": "git@1"
        },
        {
          "command": "git-brains.editSource",
          "when": "isInDiffEditor && resourceScheme != file",
          "group": "git@2"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "git-brains.annotateWithGitBlame",
          "when": "!jgc.blameActive",
          "group": "git@1"
        },
        {
          "command": "git-brains.clearGitBlameAnnotation",
          "when": "jgc.blameActive",
          "group": "git@1"
        }
      ],
      "commandPalette": [],
      "explorer/context": [
        {
          "command": "git-brains.showFileHistory",
          "when": "!explorerResourceIsFolder",
          "group": "git@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "git-brains.openPushPanel",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "git-brains.nextDiff",
        "key": "ctrl+f7",
        "mac": "cmd+f7",
        "when": "editorFocus"
      },
      {
        "command": "git-brains.prevDiff",
        "key": "ctrl+shift+f7",
        "mac": "cmd+shift+f7",
        "when": "editorFocus"
      }
    ],
    "configuration": {
"title": "%contrib.config.title%",
      "properties": {
        "jgc.locale": {
          "type": "string",
          "default": "",
          "markdownDescription": "User-interface language for the JGC panels. Leave empty to follow the VS Code display language automatically (recommended). Set a value such as `en` or `zh-cn` to force a language. Requires a window reload to take effect."
        },
        "jgc.blame.displayMode": {
          "type": "string",
          "enum": [
            "all",
            "cursor",
            "around"
          ],
          "enumDescriptions": [
            "Annotate every line of the file",
            "Only the line under the cursor",
            "The cursor line plus N lines of context (see #jgc.blame.aroundLines#)"
          ],
          "default": "all",
          "description": "Controls which lines show inline Git blame annotations."
        },
        "jgc.blame.aroundLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Lines of context above/below the cursor when jgc.blame.displayMode is 'around'."
        },
        "jgc.blame.columns": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "revision",
              "date",
              "author",
              "commitNumber"
            ],
            "enumDescriptions": [
              "Short commit hash",
              "Author date",
              "Author name",
              "Commit number (1 = newest)"
            ]
          },
          "uniqueItems": true,
          "default": [
            "date",
            "author"
          ],
          "description": "Which columns to show in inline Git blame annotations. Display order is always: Revision → Date → Author → Commit Number."
        },
        "jgc.blame.colorMode": {
          "type": "string",
          "enum": [
            "author",
            "order",
            "hide"
          ],
          "enumDescriptions": [
            "A distinct color per author",
            "JetBrains-style coloring by commit age: recent commits stand out, old ones fade",
            "Hide coloring: fixed foreground colors (#jgc.blame.foregroundColorLight# / #jgc.blame.foregroundColorDark#)"
          ],
          "default": "order",
          "description": "How inline Git blame annotations are colored."
        },
        "jgc.blame.nameStyle": {
          "type": "string",
          "enum": [
            "initials",
            "lastName",
            "firstName",
            "fullName",
            "email"
          ],
          "enumDescriptions": [
            "Author initials (e.g. ZS)",
            "Last name only",
            "First name only",
            "Full name",
            "Author email"
          ],
          "default": "fullName",
          "description": "How the author name is displayed in inline Git blame annotations."
        },
        "jgc.blame.dateFormat": {
          "type": "string",
          "default": "yyyy-MM-dd HH:mm",
          "description": "Date format for inline blame annotations. Tokens: yyyy MM dd HH mm ss."
        },
        "jgc.blame.foregroundColorLight": {
          "type": "string",
          "default": "#57606a",
          "description": "Inline blame annotation color for light themes."
        },
        "jgc.blame.foregroundColorDark": {
          "type": "string",
          "default": "#8b949e",
          "description": "Inline blame annotation color for dark themes."
        },
        "jgc.worktree.openBehavior": {
          "type": "string",
          "enum": [
            "ask",
            "thisWindow",
            "newWindow"
          ],
          "enumDescriptions": [
            "Always ask which window to open in",
            "Always open in the current window",
            "Always open in a new window"
          ],
          "default": "ask",
          "description": "Controls how projects are opened from Git worktrees."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "cd webview && pnpm run watch",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vsce:package": "pnpm run package && pnpm run build:web && vsce package --no-dependencies",
    "vsce:publish": "pnpm run package && pnpm run build:web && vsce publish --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome check src webview/src",
    "test": "vscode-test",
    "build:web": "cd webview && pnpm run build",
    "build": "pnpm run compile && pnpm run build:web",
    "dev:web": "cd webview && pnpm run dev",
    "generate:nls": "node scripts/sync-nls.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "dependencies": {
    "node-diff3": "^3.2.0"
  }
}
